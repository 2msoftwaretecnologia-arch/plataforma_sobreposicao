# Copie este arquivo para `.env` e preencha os valores.
# O mesmo `.env` é lido pelo Django (python-decouple) e pelo docker compose
# (portas do host).

# --- Django ---------------------------------------------------------------
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-chave-secreta
# Use False em produção.
DEBUG=False
# Muda o `?v=` dos estáticos no relatório impresso para furar o cache.
STATIC_VERSION=20260519

# --- Banco de dados (PostgreSQL + PostGIS) --------------------------------
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=senha
HOST_BD=127.0.0.1
PORT_BD=5432
# Segundos que a conexão com o Postgres é reaproveitada entre requisições.
DB_CONN_MAX_AGE=60

# --- GDAL / GEOS ----------------------------------------------------------
# No Docker estes caminhos já são definidos no docker-compose.yml e os
# valores abaixo são ignorados. Localmente no Windows (conda), algo como:
#   GDAL_LIBRARY_PATH=C:\Users\<usuario>\miniconda3\envs\gis\Library\bin\gdal.dll
#   GEOS_LIBRARY_PATH=C:\Users\<usuario>\miniconda3\envs\gis\Library\bin\geos_c.dll
GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# --- Celery / Redis -------------------------------------------------------
# No Docker estes valores já são definidos no docker-compose.yml.
# Os abaixo servem para rodar localmente sem Docker.
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=django-db
REDIS_URL=redis://127.0.0.1:6379/1

# --- Planet (imagens de satélite) -----------------------------------------
# Opcionais: sem eles o mapa base da Planet não é carregado.
PLANET_API_KEY=
PLANET_BASEMAP_MOSAIC=

# --- Portas no host (docker compose) --------------------------------------
# Porta pública do nginx. Também entra no CSRF_TRUSTED_ORIGINS do Django.
OVERLAY_HTTP_PORT=8020
# As portas abaixo ficam presas a 127.0.0.1 (acesso só pelo próprio servidor).
OVERLAY_APP_PORT=8001
OVERLAY_REDIS_PORT=6380
OVERLAY_RABBITMQ_PORT=5673
OVERLAY_RABBITMQ_ADMIN_PORT=15673
